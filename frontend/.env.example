# Variables de la API (lib/). En Render: servicio camybgs-api → Environment
# (render.yaml). En Vercel, mientras siga activo: Project → Settings →
# Environment Variables. Copiar a .env.local para pruebas locales, sin valores
# reales en este archivo.

# MongoDB Atlas (base camyDB en Production, camyweb-preview en Preview)
MONGO_URI=

# Resend: aviso del formulario a Omar y email de confirmación del doble opt-in
RESEND_API_KEY=
# Correo al que llega el aviso del formulario
EMAIL_USER=

# Systeme.io (contactos y etiquetas)
SYSTEME_API_KEY=

# Firma de los enlaces de confirmación del doble opt-in (lib/consentToken.js).
# Cadena aleatoria larga: openssl rand -base64 48
# Si cambia, los enlaces ya enviados dejan de funcionar.
CONSENT_SECRET=

# Dominio de los enlaces del email de confirmación, sin / final. En Render es
# obligatoria: la URL .onrender.com del sitio estático durante las pruebas y
# https://www.camybgs.com en producción. Sin definir: en Vercel Preview, la URL
# del despliegue; si no, https://www.camybgs.com (lib/emailConsentFlow.js)
SITE_URL=

# Solo Render (server/index.js): orígenes que pueden llamar a la API desde el
# navegador, separados por comas y sin / final. Sin definir:
# https://www.camybgs.com,https://camybgs.com
ALLOWED_ORIGINS=
